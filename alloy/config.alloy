
local.file_match "express_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/express/*.log",
      "job" = "express",
      "service_name" = "grafana-observibility",
    },
  ]
}

loki.source.file "express_logs" {
  targets    = local.file_match.express_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
